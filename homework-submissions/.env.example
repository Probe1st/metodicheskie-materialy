# Максимальный размер загружаемого файла в гигабайтах
MAX_UPLOAD_GB=1

# Мастер-пароль для входа в панель администратора (/admin)
ADMIN_PASSWORD=replace-with-a-long-admin-password

# Секретный ключ Flask для подписи пользовательских и административных сессий
SECRET_KEY=replace-with-a-long-random-secret

# Каталог для хранения SQLite базы доступа к группам (начинается с точки для защиты)
PRIVATE_DATA_DIR=.private
CATALOG_PROVIDER=json
