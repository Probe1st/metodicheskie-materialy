# Максимальный размер загружаемого файла в гигабайтах
MAX_UPLOAD_GB=1

# Мастер-пароль для входа в панель администратора (/admin)
ADMIN_PASSWORD=replace-with-a-long-admin-password

# Секретный ключ Flask для подписи пользовательских и административных сессий
# ОБЯЗАТЕЛЬНО замените значение перед запуском! Сгенерировать ключ:
# python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=replace-with-a-long-random-secret

# Каталог для хранения приватных данных (начинается с точки для защиты)
PRIVATE_DATA_DIR=.private

# Путь к основной базе данных SQLite v2
DATABASE_PATH=.private/app_v2.sqlite3

# Каталог для хранения загруженных файлов
STORAGE_ROOT=storage
